# Build-time (public, safe in the JS bundle) — copy to .env.local.
# Worker secrets (Supabase service role, Turnstile secret, etc.) go in
# .dev.vars instead — see .dev.vars.example. Never put secrets in this file.

# Cloudflare Turnstile site key (public half of the widget).
# Dashboard -> Turnstile -> Add widget.
# For local dev before you've created a real widget, use Cloudflare's
# always-passes test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Meta Pixel ID (Events Manager -> Data Sources -> your pixel). Public by
# design — it's visible in every page's network requests regardless.
NEXT_PUBLIC_META_PIXEL_ID=
